<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE (production) network policy: cleartext HTTP is DISABLED everywhere.
  All traffic must be HTTPS. The production API base URL is supplied at build
  time via a dart-define named API_BASE_URL set to your https endpoint.

  Cleartext to the local dev backend (LAN IP / emulator / loopback) is allowed
  ONLY in debug builds, via the debug source set's network_security_config.xml,
  which overrides this file for the debug build type.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network policy. This file overrides the strict release config
  (android/app/src/main/res/xml/network_security_config.xml) for debug builds,
  permitting cleartext HTTP to the local development backend only.

  Release/production builds never see this file, so they forbid all cleartext.
  Add your dev PC's LAN IP here if it changes.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.29.235</domain>
        <domain includeSubdomains="true">192.168.1.139</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
